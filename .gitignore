# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.ropeproject

# Credentials — never commit. .env holds a generated database password and,
# usually, a Betfair app key.
.env
.env.*
!.env.example

# Betfair client certs and session tokens
certs/
*.pem
*.key

# A credential file with an unexpected name is invisible to the CI guard,
# which checks .env and certs/ BY NAME — and this repo holds real Betfair
# credentials, which makes it the worst possible place for `git add .` to
# sweep one up.
.netrc
pgpass
secrets.json
credentials.json

# Local/test databases
*.db
*.db-wal
*.db-shm
*.sqlite
.pytest_cache/
