# betfeed configuration. Copy to .env and fill in. NEVER commit .env.

# ── Betfair ────────────────────────────────────────────────────────────────
# App key is mandatory. The rest depends on BETFAIR_LOGIN_MODE:
#   password      BETFAIR_USERNAME + BETFAIR_PASSWORD (non-interactive; fails
#                 if the account requires 2FA)
#   certs         BETFAIR_CERTS_PATH to a dir with certs.pem/private_key.pem.
#                 The reliable mode for an unattended collector.
#   session_token BETFAIR_SESSION_TOKEN from a login you did by hand.
BETFAIR_LOGIN_MODE=password
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
# BETFAIR_CERTS_PATH=/home/Joel/.betfair/certs
# BETFAIR_SESSION_TOKEN=

# ── Database ───────────────────────────────────────────────────────────────
# scripts/install_postgres.sh writes this line for you.
DATABASE_URL=postgresql://betfair@127.0.0.1:5432/betfeed

# ── Feed 1 (fixtures, no odds) ─────────────────────────────────────────────
# Which sports to walk. 1 Soccer, 4 Cricket, 7 Horse Racing, 8 Tennis,
# 10 Golf, 12 Motor Racing, 13 Rugby, 15 Basketball, 17 American Football,
# 20 Boxing, 24 Darts, 26 Snooker, 30 Esports, 4339 Racing (Aus).
# Horse racing is opt-in on purpose: it dwarfs everything else in market count.
EVENT_TYPE_IDS=1,8
# Restrict to market types, e.g. MATCH_ODDS. Empty = all types.
# This is the single biggest lever on feed 2's request volume.
MARKET_TYPE_CODES=
FIXTURES_INTERVAL_MINUTES=720

# ── Feed 2 (fixtures + odds) ───────────────────────────────────────────────
ODDS_INTERVAL_MINUTES=5
# Only poll markets starting within this window.
ODDS_HORIZON_HOURS=168
# Keep polling this long after a market starts, so its settlement is captured.
SETTLE_GRACE_MINUTES=30
LADDER_LEVELS=3
# Traded volume is the heaviest part of a price request. Off unless needed.
INCLUDE_TRADED_VOLUME=false
# Betfair caps market data at 200 weight points per request. This is a target;
# the client bisects and retries on TOO_MUCH_DATA regardless.
BOOK_CHUNK_SIZE=100

# ── Results ────────────────────────────────────────────────────────────────
# Catch events that settled while the odds job was not running.
RESULTS_BACKFILL_HOURS=48
RESULTS_BACKFILL_MAX_MARKETS=2000
# Match scores (2-1) need an app key authorised for Betfair's Scores API.
# Without one this is a harmless no-op: settlement still works.
SCORES_ENABLED=true

# ── Storage ────────────────────────────────────────────────────────────────
SNAPSHOT_RETENTION_DAYS=30
RETENTION_CHECK_EVERY_MINUTES=360

LOG_LEVEL=INFO