# OpenBettingExchangeDataFeed — configuration
#
# Copy to .env and fill in the three Betfair fields:
#     cp .env.example .env && chmod 600 .env
#
# Every value below is the ACTUAL default, so an empty .env behaves exactly as
# this file shows. Two rules:
#
#   1. .env must be chmod 600 — it holds your Betfair password.
#   2. Environment variables OVERRIDE this file. A host application can supply
#      everything here without writing a file at all.
#
# Not sure if your values will work?  uv run betfeed validate

# ── Required ───────────────────────────────────────────────────────────────

# Written for you by scripts/install_postgres.sh. There is NO default: the
# database password is generated per install, so a shipped value could never
# work. Leave this line commented out until that script fills it in.
#DATABASE_URL=postgresql://betfair:<generated>@127.0.0.1:5432/betfeed

# From Betfair: Accounts API Demo Tool -> createDeveloperAppKeys
# See the README section "Getting a Betfair API key".
BETFAIR_APP_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

# ── Betfair ────────────────────────────────────────────────────────────────

# password     a DELAY key (the default, and what Betfair issues automatically)
# certs        the account has 2FA and a client certificate is registered
# session_token you logged in by hand once and cached the token
#
# NOTE: certificate auth is NOT available on a Delay key. If you set `certs`
# with a Delay key you will get CERT_AUTH_REQUIRED.
BETFAIR_LOGIN_MODE=password

# Only used by `certs`
# BETFAIR_CERTS_PATH=/opt/betfeed/certs

# Only used by `session_token`
# BETFAIR_SESSION_TOKEN=

BETFAIR_LOCALE=en

# Which sports feed 1 walks. 1=Soccer 4=Cricket 7=Horse Racing 8=Tennis
# 10=Golf 12=Motor Racing 13=Rugby 15=Basketball 17=American Football
# 20=Boxing 24=Darts 26=Snooker 30=Esports 4339=Racing (Aus)
#
# Horse racing (7) is deliberately opt-in: it is by far the highest market count
# and will dominate every table.
EVENT_TYPE_IDS=1,8

# Restrict to specific market types (MATCH_ODDS, OVER_UNDER_25, ...).
# Empty means every type.
MARKET_TYPE_CODES=

# ── Delay-key limits ───────────────────────────────────────────────────────
#
# Betfair issues a DELAY key by default, and it is more tightly limited than a
# Live key. These defaults are MEASURED, not guessed. Raising them makes every
# catalogue or book call fail with ANGX-0001 / TOO_MUCH_DATA.
#
#   listMarketCatalogue  maxResults   <= 200
#   listMarketBook       markets/call <= 40
#
# `betfeed validate` fails if you push past either.

CATALOGUE_CHUNK_EVENTS=100
CATALOGUE_MAX_RESULTS=200
BOOK_CHUNK_SIZE=40

# VENUE and EVENT_RUNNER_DESCRIPTION are LIVE-key-only and fail a Delay key's
# request outright with DSC-0018. MARKET_DESCRIPTION is delay-safe and is where
# market_type_code comes from, so leave it in.
CATALOGUE_PROJECTION=RUNNER_DESCRIPTION,MARKET_DESCRIPTION,EVENT,EVENT_TYPE,COMPETITION,MARKET_START_TIME

# ── Cadence ────────────────────────────────────────────────────────────────

# Feed 1. NOTE: the results sweep rides inside this job, so 720 means a match
# that finishes at 14:00 may not produce a result until 02:00. If you want
# fresher settlement on feed 1, lower this — the job asks Betfair for no price
# data, so polling it more often does not burn market-data weight.
FIXTURES_INTERVAL_MINUTES=720

# Feed 2. Polling faster does NOT reduce the Delay-key data lag; it only costs
# more weight.
ODDS_INTERVAL_MINUTES=5

# How far ahead odds are polled.
ODDS_HORIZON_HOURS=168

# Minimum wait after a market reports a TERMINAL status (CLOSED / CLOSED_EVENT /
# SETTLED / VOIDED) before the odds job retires it. NOT a match length: a
# started market keeps being polled until Betfair says it is over, because the
# default sports are soccer and tennis and a soccer match runs ~2h after
# kickoff.
SETTLE_GRACE_MINUTES=30

# ── Storage ────────────────────────────────────────────────────────────────

# Price levels stored per side of the ladder.
LADDER_LEVELS=3

# Adds traded volume per selection. Costs market-data weight.
INCLUDE_TRADED_VOLUME=false

# Whole daily partitions are dropped, not deleted row by row.
SNAPSHOT_RETENTION_DAYS=30
RETENTION_CHECK_EVERY_MINUTES=360

# How far back the results sweep looks for markets that finished unnoticed.
RESULTS_BACKFILL_HOURS=48
RESULTS_BACKFILL_MAX_MARKETS=2000

# ── Optional ───────────────────────────────────────────────────────────────

# The Scores API is not authorised on every app key; this degrades quietly.
SCORES_ENABLED=true

LOG_LEVEL=INFO